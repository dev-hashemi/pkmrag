# ==============================================================================
# Project Orbit — Environment Configuration
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# LLM Inference (Phase 4 Semantic Gap Detection)
# ------------------------------------------------------------------------------
# API key for the inference provider (OpenAI, OpenRouter, Groq, etc.)
OPENAI_API_KEY=your-api-key-here

# Alternatively, set an Orbit-specific API key override
# ORBIT_LLM_API_KEY=your-orbit-api-key

# OpenAI-compatible API base URL
# Defaults to OpenAI's public API: https://api.openai.com/v1
# For local Ollama: http://localhost:11434/v1
# For local vLLM / LiteLLM: http://localhost:8000/v1
# For OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Model identifier to use for classification
# Defaults to gpt-4o-mini
# Local examples: llama3.1, mistral-nemo, qwen2.5:7b
ORBIT_LLM_MODEL=gpt-4o-mini

# Storage & Directory Overrides (Optional)
# ------------------------------------------------------------------------------
# Default LadybugDB storage directory (defaults to <vault>/.orbit/graph)
# ORBIT_DB_DIR=/custom/path/to/graph

# Default LanceDB vector storage directory (defaults to <vault>/.orbit/vectors)
# ORBIT_VECTOR_DIR=/custom/path/to/vectors
